# Copy this file to .env in the repo root and fill in real values.
# docker-compose (docker/docker-compose.yml) reads this file via env_file.

# ---------------------------------------------------------------------------
# PostgreSQL (transactional store: users, documents, chat sessions, agent runs)
# ---------------------------------------------------------------------------
POSTGRES_USER=agenticmesh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agenticmesh
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agenticmesh:change-me@postgres:5432/agenticmesh

# ---------------------------------------------------------------------------
# Redis (Celery broker/backend + pubsub)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Qdrant (vector store)
# ---------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents

# ---------------------------------------------------------------------------
# Azure AI Foundry (OpenAI-compatible endpoint, accessed via the `openai` SDK)
# Get these from your Foundry project's deployment page. ENDPOINT is the
# resource's "/openai/v1" base URL, CHAT_DEPLOYMENT is the deployed chat
# model's deployment name (used with the Responses API), and
# EMBEDDING_DEPLOYMENT is a separately deployed embeddings model.
# ---------------------------------------------------------------------------
AZURE_AI_FOUNDRY_ENDPOINT=https://fr-ai-hmg-smart-agents.services.ai.azure.com/openai/v1
AZURE_AI_FOUNDRY_API_KEY=replace-with-your-key
AZURE_AI_FOUNDRY_CHAT_DEPLOYMENT=gpt-5-mini-496403
AZURE_AI_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# text-embedding-3-large outputs 3072 dims by default; text-embedding-3-small outputs 1536.
# This MUST match the deployed model or Qdrant vector search will break.
AZURE_AI_FOUNDRY_EMBEDDING_DIMENSIONS=3072

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend misc
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/data/uploads
